{% comment %}
  BFBella — Hero. Fully custom section (DXB, 2026-09-04: "look at Hydrogen.
  create a custom section, 100% custom CSS for the hero" — supersedes the
  earlier copy-modify-native-image-banner approach for this section only).
  Structure and CSS ported from the live Hydrogen reference
  (buyflorabella_restore/dev/frontend/app/componentsMockup2/components/
  HeroSection.tsx + index.css).

  Colors (DXB, 2026-09-04: "use the standard shopify color selectors, no
  custom CSS for colors") use Dawn's own color_scheme picker -- the same
  mechanism every native Dawn section uses -- instead of bespoke per-field
  color settings. scheme-5 (unused anywhere else in this theme -- verified,
  unlike scheme-2 which drives every product/collection/blog card) is
  repurposed to carry the hero's light background / dark text / green
  button values, same precedent as scheme-4 for the header.
{% endcomment %}

<section class="bfbella-hero color-{{ section.settings.color_scheme }}" id="BfbellaHero-{{ section.id }}">
  <div class="bfbella-hero__blobs" aria-hidden="true">
    <span class="bfbella-hero__blob bfbella-hero__blob--1"></span>
    <span class="bfbella-hero__blob bfbella-hero__blob--2"></span>
  </div>

  <div class="bfbella-hero__inner">
    <div class="bfbella-hero__content">
      {%- if section.settings.show_buy_now_pill -%}
        <div class="bfbella-hero__eyebrow">
          <a href="{{ section.settings.buy_now_link | default: '#' }}" class="bfbella-hero__pill bfbella-hero__pill--shiny">
            {{ section.settings.buy_now_label | default: 'Buy Now' }}
          </a>
        </div>
      {%- endif -%}

      <h1 class="bfbella-hero__heading">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="bfbella-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <div class="bfbella-hero__body rte">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if section.settings.callout_text != blank -%}
        <div class="bfbella-hero__callout rte">{{ section.settings.callout_text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="bfbella-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 | default: '#' }}" class="bfbella-hero__button bfbella-hero__button--primary bfbella-hero__pill--shiny">
              {{ section.settings.button_label_1 }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: '#' }}" class="bfbella-hero__button bfbella-hero__button--secondary">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- assign checkmarks = section.settings.checkmarks | newline_to_br | split: '<br />' -%}
      {%- if section.settings.checkmarks != blank -%}
        <ul class="bfbella-hero__checkmarks">
          {%- for item in checkmarks -%}
            {%- assign item = item | strip -%}
            {%- if item != blank -%}
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{{ item }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="bfbella-hero__media">
      <div class="bfbella-hero__media-glow" aria-hidden="true"></div>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'bfbella-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 800, 1200, 1600',
            sizes: '(min-width: 990px) 45vw, 90vw'
        }}
      {%- else -%}
        <div class="bfbella-hero__image-placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag: 'bfbella-hero__image' }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #BfbellaHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: rgb(var(--color-background));
    padding: 4rem 0;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__blobs {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.12;
    pointer-events: none;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__blob--1 {
    top: 5%;
    left: 5%;
    width: 26rem;
    height: 26rem;
    background: rgb(var(--color-button));
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__blob--2 {
    bottom: 5%;
    right: 5%;
    width: 32rem;
    height: 32rem;
    background: rgb(var(--color-shadow));
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    #BfbellaHero-{{ section.id }} .bfbella-hero__inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__content {
    grid-column: 1;
    grid-row: 1;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__eyebrow {
    display: inline-block;
    background: rgba(var(--color-button), 0.1);
    border: 1px solid rgba(var(--color-button), 0.3);
    padding: 0.5rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-weight: 700;
    font-size: 1.4rem;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(var(--color-button), 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__pill:hover {
    transform: scale(1.08);
    box-shadow: 0 20px 35px -5px rgba(var(--color-button), 0.5);
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__heading {
    font-family: var(--font-heading-family);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: 4.4rem;
    color: rgb(var(--color-foreground));
    margin: 0 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #BfbellaHero-{{ section.id }} .bfbella-hero__heading {
      font-size: 6rem;
    }
  }

  @media screen and (min-width: 990px) {
    #BfbellaHero-{{ section.id }} .bfbella-hero__heading {
      font-size: 7rem;
    }
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__subheading {
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.4;
    color: rgba(var(--color-foreground), 0.85);
    margin: 0 0 1.5rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__body {
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.85);
    max-width: 55rem;
    margin: 0 0 1.5rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__callout {
    background: rgba(var(--color-button), 0.05);
    border: 1px solid rgba(var(--color-button), 0.2);
    border-radius: 1.5rem;
    padding: 1.5rem;
    margin: 0 0 2.5rem;
    max-width: 55rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__callout p {
    font-size: 1.3rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.85);
    margin: 0;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.4rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1.5rem;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__button--primary {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    box-shadow: 0 10px 25px -5px rgba(var(--color-button), 0.4);
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__button--primary:hover {
    transform: scale(1.08);
    box-shadow: 0 20px 35px -5px rgba(var(--color-button), 0.5);
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__button--secondary {
    background: rgb(var(--color-secondary-button));
    border: 1px solid rgba(var(--color-secondary-button-text), 0.3);
    color: rgb(var(--color-secondary-button-text));
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__button--secondary:hover {
    transform: scale(1.05);
    border-color: rgb(var(--color-secondary-button-text));
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__checkmarks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__checkmarks li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.85);
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__checkmarks svg {
    color: rgb(var(--color-button));
    flex-shrink: 0;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__media {
    position: relative;
    grid-column: 1;
    grid-row: 2;
  }

  @media screen and (min-width: 990px) {
    #BfbellaHero-{{ section.id }} .bfbella-hero__media {
      grid-column: 2;
      grid-row: 1;
    }
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__media-glow {
    position: absolute;
    inset: -1.5rem;
    background: rgba(var(--color-button), 0.2);
    border-radius: 2.5rem;
    filter: blur(30px);
    z-index: 0;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__image,
  #BfbellaHero-{{ section.id }} .bfbella-hero__image-placeholder {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    box-shadow: 0 25px 50px -12px rgba(var(--color-shadow), 0.25);
    display: block;
  }

  #BfbellaHero-{{ section.id }} .bfbella-hero__image-placeholder svg {
    width: 100%;
    height: auto;
  }
</style>

{% schema %}
{
  "name": "BFBella — Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_buy_now_pill",
      "default": true,
      "label": "Show \"Buy Now\" eyebrow pill"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "default": "Buy Now",
      "label": "Buy Now pill label"
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now pill link"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Wake Up Your Soil Today",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Bio trace minerals is an organic, ancient, formed mineral deposit that is quarried, composted and refined to bring all the natural microbes and biology to life.",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "richtext",
      "id": "callout_text",
      "default": "<p><strong>Flora Bella Living trace mineral</strong> is made from an ancient deposit of plant coral and animal life from thousands and thousands of years ago that was encapsulated in an iron, preserving all the naturally occurring biology such as beneficial mycorrhizal fungi, a diverse amount of amino acids, and other occurring goodies with our proprietary blend to bring the perfect balance for micronutrition and optimal soil health.</p>",
      "label": "Trust callout text"
    },
    {
      "type": "textarea",
      "id": "checkmarks",
      "default": "Over seventy trace minerals\nLoved by organic growers\nFrom farmers to you",
      "label": "Checkmark list (one per line)"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "Shop Bio Trace Mix",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "See Real Grower Results",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product photo"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "BFBella — Hero"
    }
  ]
}
{% endschema %}
